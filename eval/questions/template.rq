
SELECT
DISTINCT ?review ?paper ?conf
WHERE {
  \n
  SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
    ?review <http://ekaw#reviewOfPaper> ?paper .
  }\n
  SERVICE <http://192.168.100.44:3030/edas/sparql> {
    ?paper_edas <http://www.w3.org/2002/07/owl#sameAs> ?paper .
    ?paper_edas <http://edas#relatesTo> ?conf .
    ?paper_edas <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://edas#Paper> .
    ?conf <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://edas#Conference> .
  }\n
}