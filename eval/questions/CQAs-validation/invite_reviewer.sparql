#question: Who invited which reviewer?
# CQA: invite_reviewer

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: cmt
    SERVICE <http://192.168.100.44:3030/cmt/sparql> {
      ?s <http://cmt#assignExternalReviewer> ?o .
    }
  }
  UNION
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://conference#invites_co-reviewers> ?o .
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?ekaw_o3 <http://ekaw#reviewWrittenBy> ?s .
      ?ekaw_o3 <http://ekaw#reviewWrittenBy> ?o .
      ?o <http://ekaw#reviewerOfPaper> ?ekaw_o2 .
      ?ekaw_o3 <http://ekaw#reviewOfPaper> ?ekaw_o2 .
      FILTER(?o!=?s)
    }
  }
}
