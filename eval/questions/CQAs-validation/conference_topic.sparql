#question: Which topics does each conference cover?
# CQA: conference_topic

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: confof
    SERVICE <http://192.168.100.44:3030/confof/sparql> {
      ?s <http://confOf#hasTopic> ?o .
      ?s a  <http://confOf#Conference> .
    }
  }
  UNION
  {
    # source: edas
    SERVICE <http://192.168.100.44:3030/edas/sparql> {
      ?s <http://edas#hasTopic> ?o .
      ?s a <http://edas#Conference> .
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?s <http://ekaw#coversTopic> ?o .
      ?s a <http://ekaw#Conference> .
    }
  }
}
