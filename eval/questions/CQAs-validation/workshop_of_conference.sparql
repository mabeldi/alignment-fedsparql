#question: Which workshops belong to each conference?
# CQA: workshop_of_conference

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?o <http://conference#has_workshops> ?s .
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?o <http://ekaw#hasEvent> ?s .
      ?o <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://ekaw#Conference> .
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://ekaw#Workshop> .
    }
  }
}
