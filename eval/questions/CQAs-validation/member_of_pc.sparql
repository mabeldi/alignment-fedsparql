#question: Which person belongs to which program committee?
# CQA: member_of_pc

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: cmt
    SERVICE <http://192.168.100.44:3030/cmt/sparql> {
      ?s <http://cmt#memberOfProgramCommittee> ?o .
    }
  }
  UNION
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://conference#was_a_member_of> ?o . ?o <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Program_committee> .
    }
  }
}
