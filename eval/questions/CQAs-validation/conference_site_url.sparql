#question: What are the conference website URLs?
# CQA: conference_site_url

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s
WHERE {
  {
    # source: cmt
    SERVICE <http://192.168.100.44:3030/cmt/sparql> {
      ?cmt_o2 <http://cmt#siteURL> ?s .
    }
  }
  UNION
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?conference_o2 a <http://conference#Conference_www>.
      ?conference_o2 <http://conference#has_a_URL> ?s .
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?ekaw_o2 a <http://ekaw#Web_Site>.
      ?ekaw_o2 <http://www.w3.org/2000/01/rdf-schema#label> ?s.
      filter(regex(?s,"^http"))
    }
  }
}
