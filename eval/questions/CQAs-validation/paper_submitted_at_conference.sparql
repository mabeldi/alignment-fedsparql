#question: To which conference was each paper submitted?
# CQA: paper_submitted_at_conference

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://conference#is_submitted_at> ?o .
    }
  }
  UNION
  {
    # source: edas
    SERVICE <http://192.168.100.44:3030/edas/sparql> {
      ?s <http://edas#relatesTo> ?o .
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://edas#Paper> .
      ?o <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://edas#Conference> .
    }
  }
}
