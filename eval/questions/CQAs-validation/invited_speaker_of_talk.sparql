#question: Which invited speaker gives each invited talk?
# CQA: invited_speaker_of_talk

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s a <http://conference#Invited_speaker>.
      ?s <http://conference#contributes> ?o .
      ?o a <http://conference#Invited_talk>.
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?s a <http://ekaw#Invited_Speaker>.
      ?ekaw_o2 <http://ekaw#writtenBy> ?s.
      ?ekaw_o2 <http://ekaw#paperPresentedAs> ?o.
      ?o a <http://ekaw#Invited_Talk>.
    }
  }
}
