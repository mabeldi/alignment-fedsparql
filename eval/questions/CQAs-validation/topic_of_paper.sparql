#question: Which topics does each paper cover?
# CQA: topic_of_paper

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: cmt
    SERVICE <http://192.168.100.44:3030/cmt/sparql> {
      ?s a <http://cmt#PaperFullVersion> .
      ?s <http://cmt#hasSubjectArea> ?o .
    }
  }
  UNION
  {
    # source: confof
    SERVICE <http://192.168.100.44:3030/confof/sparql> {
      ?s <http://confOf#dealsWith> ?o .
    }
  }
  UNION
  {
    # source: edas
    SERVICE <http://192.168.100.44:3030/edas/sparql> {
      ?s <http://edas#hasTopic> ?o . ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://edas#Paper> .
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?s <http://ekaw#coversTopic> ?o . ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://ekaw#Paper> .
    }
  }
}
