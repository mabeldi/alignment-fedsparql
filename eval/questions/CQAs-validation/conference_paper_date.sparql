#question: What is the paper-submission deadline for each conference?
# CQA: conference_paper_date

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://conference#has_important_dates> ?conference_o2 . ?conference_o2 <http://conference#is_a_full_paper_submission_date> ?o .
    }
  }
  UNION
  {
    # source: confof
    SERVICE <http://192.168.100.44:3030/confof/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://confOf#Conference> . ?s <http://confOf#hasAdministrativeEvent> ?confof_o2 . ?confof_o2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://confOf#Submission_event> . ?confof_o2 <http://confOf#ends_on> ?o .
    }
  }
  UNION
  {
    # source: edas
    SERVICE <http://192.168.100.44:3030/edas/sparql> {
      ?s <http://edas#manuscriptDueOn> ?o .
    }
  }
}
