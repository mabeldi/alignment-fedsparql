#question: Who presents each paper presentation?
# CQA: presenter_of_paper_presentation

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://conference#gives_presentations> ?o.
      ?o a <http://conference#Presentation>.
    }
  }
  UNION
  {
    # source: edas
    SERVICE <http://192.168.100.44:3030/edas/sparql> {
      ?o a <http://edas#PaperPresentation>.
      ?edas_o3 <http://edas#relatesTo> ?o .
      ?edas_o3 a <http://edas#SlideSet> .
      ?edas_o3 <http://edas#relatesTo> ?s .
      ?s a <http://edas#Presenter> .
    }
  }
}
