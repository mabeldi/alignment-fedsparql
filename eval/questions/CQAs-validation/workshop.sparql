#question: Which workshops are scheduled?
# CQA: workshop

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s
WHERE {
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Workshop> .
    }
  }
  UNION
  {
    # source: confof
    SERVICE <http://192.168.100.44:3030/confof/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://confOf#Workshop> .
    }
  }
  UNION
  {
    # source: edas
    SERVICE <http://192.168.100.44:3030/edas/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://edas#Workshop> .
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://ekaw#Workshop> .
    }
  }
}
