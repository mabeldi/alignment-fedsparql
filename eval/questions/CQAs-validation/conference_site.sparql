#question: Which conference websites are described?
# CQA: conference_site

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s
WHERE {
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Conference_www> .
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://ekaw#Web_Site> .
    }
  }
}
