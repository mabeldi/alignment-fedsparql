#question: What is each person's full name?
# CQA: person_name

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: cmt
    SERVICE <http://192.168.100.44:3030/cmt/sparql> {
      ?s <http://cmt#name> ?o .
      ?s a <http://cmt#Person> .
    }
  }
  UNION
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://conference#has_the_first_name> ?conference_o1 .
      ?s <http://conference#has_the_last_name> ?conference_o2 .
      BIND( concat(STR(?conference_o1)," ", STR(?conference_o2)) as ?o)
    }
  }
  UNION
  {
    # source: confof
    SERVICE <http://192.168.100.44:3030/confof/sparql> {
      ?s <http://confOf#hasFirstName> ?confof_o1 .
      ?s <http://confOf#hasSurname> ?confof_o2 .
      BIND( concat(STR(?confof_o1)," ", STR(?confof_o2)) as ?o)
    }
  }
  UNION
  {
    # source: edas
    SERVICE <http://192.168.100.44:3030/edas/sparql> {
      ?s <http://edas#hasFirstName> ?edas_o1 .
      ?s <http://edas#hasLastName> ?edas_o2 .
      BIND( concat(STR(?edas_o1)," ", STR(?edas_o2)) as ?o)
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?s <http://www.w3.org/2000/01/rdf-schema#label> ?o .
      ?s a <http://ekaw#Person> .
    }
  }
}
