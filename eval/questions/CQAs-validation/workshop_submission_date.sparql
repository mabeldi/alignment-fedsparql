#question: What is the paper-submission deadline for each workshop?
# CQA: workshop_submission_date

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: confof
    SERVICE <http://192.168.100.44:3030/confof/sparql> {
      ?s a <http://confOf#Workshop> .
      ?s <http://confOf#hasAdministrativeEvent> ?confof_o2 .
      ?confof_o2 a <http://confOf#Submission_event>.
      ?confof_o2 <http://confOf#ends_on> ?o.
    }
  }
  UNION
  {
    # source: edas
    SERVICE <http://192.168.100.44:3030/edas/sparql> {
      ?s a <http://edas#Workshop> .
      ?s <http://edas#hasCall> ?edas_o2 .
      ?edas_o2 a <http://edas#CallForManuscripts>.
      ?edas_o2 <http://edas#hasSubmissionDeadline> ?o .
    }
  }
}
