#question: Which abstracts are invited-talk abstracts?
# CQA: invited_talk_abstract

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s
WHERE {
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://conference#is_the_1th_part_of> ?conference_o2 . ?conference_o2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Invited_talk> .
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://ekaw#Invited_Talk_Abstract> .
    }
  }
}
