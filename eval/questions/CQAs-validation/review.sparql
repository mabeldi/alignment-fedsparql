#question: Which reviews are there?
# CQA: review

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s
WHERE {
  {
    # source: cmt
    SERVICE <http://192.168.100.44:3030/cmt/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://cmt#Review> .
    }
  }
  UNION
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Review> .
    }
  }
  UNION
  {
    # source: edas
    SERVICE <http://192.168.100.44:3030/edas/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://edas#Review> .
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://ekaw#Review> .
    }
  }
}
