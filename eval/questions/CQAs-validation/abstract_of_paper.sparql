#question: Which abstract belongs to each paper?
# CQA: abstract_of_paper

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: cmt
    SERVICE <http://192.168.100.44:3030/cmt/sparql> {
      ?s a <http://cmt#PaperFullVersion> .
      ?o a <http://cmt#PaperAbstract> .
      ?s <http://cmt#title> ?cmt_o2 .
      ?o <http://cmt#title> ?cmt_o2 .
    }
  }
  UNION
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s a <http://conference#Written_contribution> .
      ?s <http://conference#has_an_abstract> ?o .
    }
  }
}
