#question: Which assigned reviewers authored which reviews?
# CQA: assigned_reviewer_author_of_review

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: cmt
    SERVICE <http://192.168.100.44:3030/cmt/sparql> {
      ?s <http://cmt#writeReview> ?o .
    }
  }
  UNION
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://conference#contributes> ?o .
      ?o <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Review> .
      ?s <http://conference#was_a_member_of> ?conference_o3 . ?conference_o3 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Program_committee> .
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?o <http://ekaw#reviewWrittenBy> ?s .
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://ekaw#PC_Member> .
      ?s <http://ekaw#reviewerOfPaper> ?ekaw_o3.
    }
  }
}
