#question: Which papers were accepted?
# CQA: accepted_paper

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s
WHERE {
  {
    # source: cmt
    SERVICE <http://192.168.100.44:3030/cmt/sparql> {
      { ?s <http://cmt#hasDecision> ?cmt_o2 .
       ?cmt_o2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://cmt#Acceptance> . } 
       UNION  { ?s <http://cmt#acceptedBy> ?cmt_o2 . }
    }
  }
  UNION
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Accepted_contribution> .
    }
  }
  UNION
  {
    # source: edas
    SERVICE <http://192.168.100.44:3030/edas/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://edas#AcceptedPaper> .
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://ekaw#Accepted_Paper> .
    }
  }
}
