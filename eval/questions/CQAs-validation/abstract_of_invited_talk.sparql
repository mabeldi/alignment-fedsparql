#question: Which abstract belongs to each invited talk?
# CQA: abstract_of_invited_talk

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s a <http://conference#Abstract>.
      ?o <http://conference#has_an_abstract> ?s .
      ?o a <http://conference#Invited_talk>.
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.44:3030/ekaw/sparql> {
      ?s a <http://ekaw#Invited_Talk_Abstract>.
      ?s <http://ekaw#paperPresentedAs> ?o.
      ?o a <http://ekaw#Invited_Talk>.
    }
  }
}
