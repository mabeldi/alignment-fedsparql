#question: What is the start date of each conference?
# CQA: conference_start_date

# federation: UNION of complete alternative answers from each source

SELECT DISTINCT ?s ?o
WHERE {
  {
    # source: cmt
    SERVICE <http://192.168.100.44:3030/cmt/sparql> {
     ?s a <http://cmt#Conference> .
      ?s <http://cmt#date> ?o .
    }
  }
  UNION
  {
    # source: conference
    SERVICE <http://192.168.100.44:3030/conference/sparql> {
      ?s <http://conference#has_important_dates> ?conference_o2 .
      ?s a <http://conference#Conference_volume> .
      ?conference_o2 <http://conference#is_a_starting_date> ?o .
    }
  }
  UNION
  {
    # source: confof
    SERVICE <http://192.168.100.44:3030/confof/sparql> {
      ?s <http://confOf#starts_on> ?o .
      ?s a <http://confOf#Conference> .
    }
  }
  UNION
  {
    # source: edas
    SERVICE <http://192.168.100.44:3030/edas/sparql> {
      ?s <http://edas#startDate> ?o .
      ?s a <http://edas#Conference> .
    }
  }
}
