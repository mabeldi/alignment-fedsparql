# Copy this file to app/.env and fill in the values you need.
# Only the provider(s) named in app/config/agent_models.yaml need a key.

# LLM providers
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
HUGFACE_API_KEY=
VERCEL_AI_API_KEY=
# AI_GATEWAY_API_KEY=            # alternative name for VERCEL_AI_API_KEY
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# VERCEL_MAX_TOKENS=25384
# GEMINI_RPM=15
# GEMINI_MAX_RETRIES=4

# Vector database (Qdrant) and embeddings (Ollama)
QDRANT_URL=http://localhost:6333
OLLAMA_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=qwen3-embedding:4b
# AGENT2_MIN_SCORE=0.70

# SPARQL endpoints (Fuseki)
FUSEKI_BASE_URL=http://localhost:3030
