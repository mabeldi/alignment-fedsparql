PREFIX conference: <http://conference#>
PREFIX confof: <http://confOf#>
PREFIX edas: <http://edas#>
SELECT DISTINCT ?conference ?startDate
WHERE {
{ SERVICE <http://192.168.100.45:3030/edas/sparql> { ?conference a edas:Conference . ?conference edas:startDate ?startDate . } }
UNION
{ SERVICE <http://192.168.100.45:3030/conference/sparql> { ?conference a conference:Conference_volume . ?conference conference:has_important_dates ?important_dates . ?important_dates conference:is_a_starting_date ?startDate . } }
UNION
{ SERVICE <http://192.168.100.45:3030/confof/sparql> { ?conference a confof:Conference . ?conference confof:starts_on ?startDate . } }
}
