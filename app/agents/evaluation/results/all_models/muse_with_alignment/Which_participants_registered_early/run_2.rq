PREFIX conference: <http://conference#>
PREFIX confof: <http://confOf#>
PREFIX ekaw: <http://ekaw#>
SELECT DISTINCT ?early_registered_participant
WHERE {
{ SERVICE <http://192.168.100.45:3030/ekaw/sparql> { ?early_registered_participant a ekaw:Early-Registered_Participant . } }
UNION
{ SERVICE <http://192.168.100.45:3030/conference/sparql> { ?early_registered_participant a conference:Early_paid_applicant . } }
UNION
{ SERVICE <http://192.168.100.45:3030/confof/sparql> { ?early_registered_participant a confof:Participant . ?early_registered_participant confof:earlyRegistration "true" . } }
}
