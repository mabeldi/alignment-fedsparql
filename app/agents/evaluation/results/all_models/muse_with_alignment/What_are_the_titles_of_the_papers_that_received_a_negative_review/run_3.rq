PREFIX cmt: <http://cmt#>
PREFIX ekaw: <http://ekaw#>
SELECT DISTINCT ?title WHERE { SERVICE <http://192.168.100.45:3030/ekaw/sparql> { ?paper a ekaw:Paper . ?negative_review a ekaw:Negative_Review . ?paper ekaw:hasReview ?negative_review . } SERVICE <http://192.168.100.45:3030/cmt/sparql> { ?paper_cmt <http://www.w3.org/2002/07/owl#sameAs> ?paper . ?paper_cmt a cmt:Paper . ?paper_cmt cmt:title ?title . } }
