
PREFIX conference: <http://conference#>
PREFIX ekaw: <http://ekaw#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT
DISTINCT ?invited_speaker
WHERE {
    {

        SERVICE <http://192.168.100.45:3030/ekaw/sparql> {
            ?invited_speaker a ekaw:Invited_Speaker .
        }
    }
    UNION {

        SERVICE <http://192.168.100.45:3030/conference/sparql> {
            ?invited_speaker a conference:Invited_speaker .
        }
    }
}