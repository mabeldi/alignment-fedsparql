
PREFIX conference: <http://conference#>
PREFIX ekaw: <http://ekaw#>

SELECT DISTINCT ?s
WHERE {
  {
    # source: conference
    SERVICE <http://192.168.100.45:3030/conference/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://conference#Invited_speaker> .
    }
  }
  UNION
  {
    # source: ekaw
    SERVICE <http://192.168.100.45:3030/ekaw/sparql> {
      ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://ekaw#Invited_Speaker> .
    }
  }
}
