PREFIX confof: <http://confOf#>
PREFIX ekaw: <http://ekaw#>
SELECT DISTINCT ?camera_ready_event WHERE { { SERVICE <http://192.168.100.45:3030/confof/sparql> { ?camera_ready_event a confof:Camera_Ready_event . } } UNION { SERVICE <http://192.168.100.45:3030/ekaw/sparql> { ?camera_ready_event a ekaw:Individual_Presentation . ?camera_ready_event ekaw:presentationOfPaper ?paper . ?paper a ekaw:Camera_Ready_Paper . } } }
