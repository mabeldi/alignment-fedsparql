PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX confof: <http://confOf#>
PREFIX ekaw: <http://ekaw#>

# Question: Retrieve the list of camera-ready events.
# Complex mapping:
# confof:Camera_Ready_event =
#   ekaw:Individual_Presentation
#   AND (ekaw:presentationOfPaper -> ekaw:Camera_Ready_Paper)

SELECT DISTINCT ?event
WHERE {
  {
    SERVICE <http://192.168.100.45:3030/confof/sparql> {
      ?event rdf:type confof:Camera_Ready_event .
    }
  }
  UNION
  {
    SERVICE <http://192.168.100.45:3030/ekaw/sparql> {
      ?event rdf:type ekaw:Individual_Presentation .
      ?event ekaw:presentationOfPaper ?paper .
      ?paper rdf:type ekaw:Camera_Ready_Paper .
    }
  }
}