PREFIX conference: <http://conference#>
PREFIX confof: <http://confOf#>
PREFIX edas: <http://edas#>
PREFIX ekaw: <http://ekaw#>
SELECT DISTINCT ?topic WHERE { { SERVICE <http://192.168.100.45:3030/confof/sparql> { ?topic a confof:Topic . } } UNION { SERVICE <http://192.168.100.45:3030/conference/sparql> { ?topic a conference:Topic . } } UNION { SERVICE <http://192.168.100.45:3030/edas/sparql> { ?topic a edas:Topic . } } UNION { SERVICE <http://192.168.100.45:3030/ekaw/sparql> { ?topic a ekaw:Research_Topic . } } }
