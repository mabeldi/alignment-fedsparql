PREFIX confof: <http://confOf#>
PREFIX edas: <http://edas#>
SELECT DISTINCT ?conference ?starts_on
WHERE {
{ SERVICE <http://192.168.100.45:3030/confof/sparql> { ?conference a confof:Conference . ?conference confof:starts_on ?starts_on . } }
UNION
{ SERVICE <http://192.168.100.45:3030/edas/sparql> { ?conference a edas:Conference . ?conference edas:startDate ?starts_on . } }
}
