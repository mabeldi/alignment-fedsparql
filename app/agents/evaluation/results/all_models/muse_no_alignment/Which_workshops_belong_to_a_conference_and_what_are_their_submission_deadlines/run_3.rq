PREFIX edas: <http://edas#>
PREFIX ekaw: <http://ekaw#>
SELECT DISTINCT ?workshop ?conference ?submissionDeadline WHERE { { SERVICE <http://192.168.100.45:3030/edas/sparql> { ?workshop a edas:Workshop . ?workshop edas:hasCall ?call . ?call a edas:Call . ?call edas:hasSubmissionDeadline ?submissionDeadline . } SERVICE <http://192.168.100.45:3030/ekaw/sparql> { ?workshopEkaw <http://www.w3.org/2002/07/owl#sameAs> ?workshop . ?workshopEkaw a ekaw:Workshop . ?conference a ekaw:Conference . ?workshopEkaw ekaw:partOfEvent ?conference . } } UNION { SERVICE <http://192.168.100.45:3030/ekaw/sparql> { ?workshop a ekaw:Workshop . ?workshop ekaw:partOfEvent ?conference . ?conference a ekaw:Conference . } SERVICE <http://192.168.100.45:3030/edas/sparql> { ?workshopEdas <http://www.w3.org/2002/07/owl#sameAs> ?workshop . ?workshopEdas a edas:Workshop . ?workshopEdas edas:hasCall ?call . ?call a edas:Call . ?call edas:hasSubmissionDeadline ?submissionDeadline . } } }
