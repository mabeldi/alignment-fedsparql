<map>
	<Cell>
			<entity1  rdf:resource="http://conference#Presentation"/> 
			<entity2> 
				<Class>  
					<and>  
						<Class rdf:resource="http://edas#Paper"/>  
					</and>   
					<and>    
						<AttributeTypeCondition>     
							<onAttribute>     
								<Relation rdf:resource="http://edas#isWrittenBy"/>
							</onAttribute>     
							<value>
								<Instance rdf:resource="http://edas#Presenter" />
							</value>
						</AttributeTypeCondition> 
					</and>  
				</Class> 
			</entity2>
			<relation>=</relation>
	</Cell>
</map>




<map>
	<Cell>
			<entity1  rdf:resource="http://conference#Written_contribution"/> 
			<entity2> 
				<Class>  
					<and>  
						<Class rdf:resource="http://edas#Document"/>  
					</and>   
					<and>    
						<AttributeTypeCondition>     
							<onAttribute>     
								<Relation rdf:resource="http://edas#relatesTo"/>
							</onAttribute>     
							<value>
								<Instance rdf:resource="http://edas#Author" />
							</value>
						</AttributeTypeCondition> 
					</and>  
				</Class> 
			</entity2>
			<relation>=</relation>
	</Cell>
</map>








