<map>
	<Cell>
			<entity1  rdf:resource="http://conference#Rejected_contribution"/> 
			<entity2> 
				<Class>  
					<and>  
						<Class rdf:resource="http://cmt#Paper"/>  
					</and>   
					<and>    
						<AttributeTypeCondition>     
							<onAttribute>     
								<Relation rdf:resource="http://cmt#hasDecision"/>
							</onAttribute>     
							<value>
								<Instance rdf:resource="http://cmt#Rejection" />
							</value>
						</AttributeTypeCondition> 
					</and>  
				</Class> 
			</entity2>
			<relation>=</relation>
	</Cell>
