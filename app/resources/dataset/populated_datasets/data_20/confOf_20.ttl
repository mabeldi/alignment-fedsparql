<http://confOf>  a  owl:Ontology .

:dealsWith  a         owl:ObjectProperty ;
        rdfs:comment  "confTool" ;
        rdfs:domain   :Contribution ;
        rdfs:range    :Topic .

:Contribution  a          owl:Class ;
