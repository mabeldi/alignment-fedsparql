        rdfs:subClassOf   owl:Thing , _:b0 , _:b1 , _:b2 , _:b3 , _:b4 , _:b5 , _:b6 , _:b7 , _:b8 , _:b9 , _:b10 , _:b11 ;
        owl:disjointWith  :Topic , :Person , :Organization , :Country , :Event .

:Topic  a             owl:Class ;
