<http://ekaw>  a  owl:Ontology .

:Event  a                 owl:Class ;
        owl:disjointWith  :Person .

:Person  a                owl:Class ;
        owl:disjointWith  :Event , :Document , :Organisation , :Location .

:Accepted_Paper  a        owl:Class ;
        rdfs:comment      "Accepted paper to become part of proceedings. \nNote that camera-ready paper is not considered as 'accepted paper', as it was accepted in a different form!" ;
        rdfs:subClassOf   :Evaluated_Paper , _:b0 , _:b1 , _:b2 ;
        owl:disjointWith  :Rejected_Paper , :Camera_Ready_Paper .

:Rejected_Paper  a        owl:Class ;
        rdfs:subClassOf   :Evaluated_Paper ;
        owl:disjointWith  :Accepted_Paper .

:Evaluated_Paper  a       owl:Class ;
        rdfs:subClassOf   :Assigned_Paper , _:b3 , _:b4 , _:b5 ;
        owl:disjointWith  :Camera_Ready_Paper .

:Camera_Ready_Paper  a    owl:Class ;
        rdfs:subClassOf   :Paper , _:b6 , _:b7 , _:b8 , _:b9 , _:b10 , _:b11 ;
        owl:disjointWith  :Accepted_Paper , :Evaluated_Paper , :Submitted_Paper .

:Positive_Review  a       owl:Class ;
        rdfs:subClassOf   :Review ;
        owl:disjointWith  :Negative_Review , :Neutral_Review .

:hasReview  a          owl:ObjectProperty ;
        rdfs:domain    :Paper ;
        rdfs:range     :Review ;
        owl:inverseOf  :reviewOfPaper .

:Workshop_Paper  a        owl:Class ;
        rdfs:subClassOf   :Paper ;
        owl:disjointWith  :Industrial_Paper , :Conference_Paper .

:Industrial_Paper  a      owl:Class ;
        rdfs:subClassOf   :Paper ;
        owl:disjointWith  :Workshop_Paper , :Poster_Paper , :Regular_Paper , :Demo_Paper .

:Paper  a                 owl:Class ;
        rdfs:subClassOf   :Document ;
        owl:disjointWith  :Review , :Proceedings , :Programme_Brochure , :Flyer , :Web_Site , :Multi-author_Volume .

:Conference_Paper  a      owl:Class ;
        rdfs:subClassOf   :Paper ;
        owl:disjointWith  :Workshop_Paper .

:Industrial_Session  a   owl:Class ;
        rdfs:subClassOf  :Conference_Session .

:Conference_Session  a    owl:Class ;
        rdfs:subClassOf   :Session ;
        rdfs:subClassOf   [ a                   owl:Restriction ;
                            owl:onProperty      :partOfEvent ;
                            owl:someValuesFrom  :Conference
                          ] ;
        rdfs:subClassOf   [ a                   owl:Restriction ;
                            owl:onProperty      :partOfEvent ;
                            owl:someValuesFrom  :Conference
                          ] ;
        rdfs:subClassOf   [ a                   owl:Restriction ;
                            owl:onProperty      :partOfEvent ;
                            owl:someValuesFrom  :Conference
                          ] ;
        owl:disjointWith  :Workshop_Session .

:Regular_Session  a       owl:Class ;
        rdfs:subClassOf   :Session ;
        owl:disjointWith  :Poster_Session , :Demo_Session .

:Poster_Session  a        owl:Class ;
        rdfs:subClassOf   :Session ;
        owl:disjointWith  :Regular_Session , :Demo_Session .

:Demo_Session  a          owl:Class ;
        rdfs:subClassOf   :Session ;
        owl:disjointWith  :Regular_Session , :Poster_Session .

:Session  a               owl:Class ;
        rdfs:subClassOf   :Scientific_Event ;
        rdfs:subClassOf   [ a                  owl:Restriction ;
                            owl:allValuesFrom  [ a            owl:Class ;
                                                 owl:unionOf  ( :Conference :Track :Workshop )
                                               ] ;
                            owl:onProperty     :partOfEvent
                          ] ;
        rdfs:subClassOf   [ a                   owl:Restriction ;
                            owl:onProperty      :hasEvent ;
                            owl:someValuesFrom  :Individual_Presentation
                          ] ;
        rdfs:subClassOf   [ a                   owl:Restriction ;
                            owl:onProperty      :partOfEvent ;
                            owl:someValuesFrom  [ a            owl:Class ;
                                                  owl:unionOf  ( :Conference :Workshop )
                                                ]
                          ] ;
        rdfs:subClassOf   [ a                  owl:Restriction ;
                            owl:allValuesFrom  [ a            owl:Class ;
                                                 owl:unionOf  ( :Conference :Track :Workshop )
                                               ] ;
                            owl:onProperty     :partOfEvent
                          ] ;
        rdfs:subClassOf   [ a                   owl:Restriction ;
                            owl:onProperty      :hasEvent ;
                            owl:someValuesFrom  :Individual_Presentation
                          ] ;
        rdfs:subClassOf   [ a                   owl:Restriction ;
                            owl:onProperty      :partOfEvent ;
                            owl:someValuesFrom  [ a            owl:Class ;
                                                  owl:unionOf  ( :Conference :Workshop )
                                                ]
                          ] ;
        rdfs:subClassOf   [ a                  owl:Restriction ;
                            owl:allValuesFrom  [ a            owl:Class ;
                                                 owl:unionOf  ( :Conference :Track :Workshop )
                                               ] ;
                            owl:onProperty     :partOfEvent
                          ] ;
        rdfs:subClassOf   [ a                   owl:Restriction ;
                            owl:onProperty      :hasEvent ;
                            owl:someValuesFrom  :Individual_Presentation
                          ] ;
        rdfs:subClassOf   [ a                   owl:Restriction ;
                            owl:onProperty      :partOfEvent ;
                            owl:someValuesFrom  [ a            owl:Class ;
                                                  owl:unionOf  ( :Conference :Workshop )
                                                ]
                          ] ;
        owl:disjointWith  :Track , :Invited_Talk , :Workshop , :Tutorial , :Contributed_Talk , :Conference .

:Abstract  a             owl:Class ;
        rdfs:subClassOf  :Document .

:Document  a              owl:Class ;
        owl:disjointWith  :Person .

:Paper_Author  a         owl:Class ;
        rdfs:subClassOf  :Person .

:Conference_Trip  a      owl:Class ;
        rdfs:subClassOf  :Social_Event .

:Social_Event  a          owl:Class ;
        rdfs:subClassOf   :Event ;
        owl:disjointWith  :Track , :Invited_Talk , :Workshop , :Tutorial , :Contributed_Talk , :Conference .

:Tutorial_Abstract  a    owl:Class ;
        rdfs:subClassOf  :Abstract .

:writtenBy  a          owl:ObjectProperty ;
        rdfs:domain    :Document ;
        rdfs:range     :Person ;
        owl:inverseOf  :authorOf .

:Conference_Participant
        a                owl:Class ;
        rdfs:subClassOf  :Person .

:Submitted_Paper  a       owl:Class ;
        rdfs:subClassOf   :Paper ;
        owl:disjointWith  :Camera_Ready_Paper .

:updatedVersionOf  a   owl:ObjectProperty ;
        rdfs:domain    :Document ;
        rdfs:range     :Document ;
        owl:inverseOf  :hasUpdatedVersion .

:Assigned_Paper  a       owl:Class ;
        rdfs:subClassOf  :Submitted_Paper , _:b12 , _:b13 , _:b14 .

:Negative_Review  a       owl:Class ;
        rdfs:subClassOf   :Review ;
        owl:disjointWith  :Positive_Review , :Neutral_Review .

:Review  a                owl:Class ;
        rdfs:subClassOf   :Document ;
        owl:disjointWith  :Paper , :Proceedings , :Programme_Brochure , :Flyer , :Web_Site , :Multi-author_Volume .

:Neutral_Review  a        owl:Class ;
        rdfs:subClassOf   :Review ;
        owl:disjointWith  :Positive_Review , :Negative_Review .

:Research_Topic  a  owl:Class .

:Organising_Agency  a     owl:Class ;
        rdfs:subClassOf   :Organisation ;
        owl:disjointWith  :Academic_Institution .

:Academic_Institution
        a                 owl:Class ;
        rdfs:subClassOf   :Organisation ;
        owl:disjointWith  :Organising_Agency .

:Organisation  a          owl:Class ;
        owl:disjointWith  :Person .

:Proceedings_Publisher
        a                owl:Class ;
        rdfs:subClassOf  :Organisation .

:Poster_Paper  a          owl:Class ;
        rdfs:subClassOf   :Paper ;
        owl:disjointWith  :Industrial_Paper , :Regular_Paper , :Demo_Paper .

:Regular_Paper  a         owl:Class ;
        rdfs:subClassOf   :Paper ;
        owl:disjointWith  :Industrial_Paper , :Poster_Paper , :Demo_Paper .

:Demo_Paper  a            owl:Class ;
        rdfs:subClassOf   :Paper ;
        owl:disjointWith  :Industrial_Paper , :Poster_Paper , :Regular_Paper .

:Location  a              owl:Class ;
        owl:disjointWith  :Person .

:Research_Institute  a   owl:Class ;
        rdfs:subClassOf  :Academic_Institution .

:Scientific_Event  a     owl:Class ;
        rdfs:subClassOf  :Event .

:hasReviewer  a        owl:ObjectProperty ;
        rdfs:domain    :Paper ;
        rdfs:range     :Possible_Reviewer ;
        owl:inverseOf  :reviewerOfPaper .

:Invited_Talk_Abstract
        a                owl:Class ;
        rdfs:subClassOf  :Abstract .

:Agency_Staff_Member  a  owl:Class ;
        rdfs:subClassOf  :Person .

:Workshop_Session  a      owl:Class ;
        rdfs:subClassOf   :Session ;
        owl:disjointWith  :Conference_Session .

:Track  a                 owl:Class ;
        rdfs:subClassOf   :Scientific_Event ;
        owl:disjointWith  :Session , :Social_Event , :Invited_Talk , :Workshop , :Tutorial , :Contributed_Talk , :Conference .

:Invited_Talk  a          owl:Class ;
        rdfs:subClassOf   :Individual_Presentation ;
        owl:disjointWith  :Session , :Social_Event , :Track , :Workshop , :Tutorial , :Contributed_Talk , :Conference .

:Workshop  a              owl:Class ;
        rdfs:subClassOf   :Scientific_Event ;
        owl:disjointWith  :Session , :Social_Event , :Track , :Invited_Talk , :Tutorial , :Conference , :Individual_Presentation .

:Tutorial  a              owl:Class ;
        rdfs:subClassOf   :Individual_Presentation ;
        owl:disjointWith  :Session , :Social_Event , :Track , :Invited_Talk , :Workshop , :Contributed_Talk , :Conference .

:Contributed_Talk  a      owl:Class ;
        rdfs:subClassOf   :Individual_Presentation , _:b15 , _:b16 , _:b17 , _:b18 , _:b19 , _:b20 ;
        owl:disjointWith  :Session , :Social_Event , :Track , :Invited_Talk , :Tutorial , :Conference .

:Conference  a            owl:Class ;
        rdfs:comment      "One edition of a conference" ;
        rdfs:subClassOf   :Scientific_Event ;
        owl:disjointWith  :Session , :Social_Event , :Track , :Invited_Talk , :Workshop , :Tutorial , :Contributed_Talk .

:Demo_Chair  a           owl:Class ;
        rdfs:subClassOf  :Conference_Participant .

:Tutorial_Chair  a        owl:Class ;
        rdfs:subClassOf   :Conference_Participant , :PC_Member ;
        owl:disjointWith  :PC_Chair .

:PC_Chair  a              owl:Class ;
        rdfs:subClassOf   :Conference_Participant , :PC_Member ;
        owl:disjointWith  :Tutorial_Chair , :Workshop_Chair .

:PC_Member  a            owl:Class ;
        rdfs:subClassOf  :Possible_Reviewer .

:OC_Member  a            owl:Class ;
        rdfs:subClassOf  :Conference_Participant .

:Proceedings  a           owl:Class ;
        rdfs:subClassOf   :Multi-author_Volume , _:b21 , _:b22 , _:b23 , _:b24 , _:b25 , _:b26 ;
        owl:disjointWith  :Paper , :Review , :Programme_Brochure , :Flyer , :Web_Site .

:Programme_Brochure  a    owl:Class ;
        rdfs:subClassOf   :Document ;
        owl:disjointWith  :Paper , :Review , :Proceedings , :Flyer , :Web_Site , :Multi-author_Volume .

:Flyer  a                 owl:Class ;
        rdfs:subClassOf   :Document ;
        owl:disjointWith  :Paper , :Review , :Proceedings , :Programme_Brochure , :Web_Site , :Multi-author_Volume .

:Web_Site  a              owl:Class ;
        rdfs:subClassOf   :Document ;
        owl:disjointWith  :Paper , :Review , :Proceedings , :Programme_Brochure , :Flyer , :Multi-author_Volume .

:Multi-author_Volume  a   owl:Class ;
        rdfs:subClassOf   :Document ;
        owl:disjointWith  :Paper , :Review , :Programme_Brochure , :Flyer , :Web_Site .

:Individual_Presentation
        a                 owl:Class ;
        rdfs:subClassOf   :Scientific_Event ;
        owl:disjointWith  :Workshop .

:OC_Chair  a             owl:Class ;
        rdfs:subClassOf  :OC_Member .

:Conference_Banquet  a   owl:Class ;
        rdfs:subClassOf  :Social_Event .

:Workshop_Chair  a        owl:Class ;
        rdfs:subClassOf   :Conference_Participant , :PC_Member ;
        owl:disjointWith  :PC_Chair .

:Conference_Proceedings
        a                owl:Class ;
        rdfs:subClassOf  :Proceedings , _:b27 , _:b28 , _:b29 .

:volumeContainsPaper  a  owl:ObjectProperty ;
        owl:inverseOf  :paperInVolume .

:Session_Chair  a        owl:Class ;
        rdfs:subClassOf  :Conference_Participant , :PC_Member .

:Early-Registered_Participant
        a                 owl:Class ;
        rdfs:subClassOf   :Conference_Participant ;
        owl:disjointWith  :Late-Registered_Participant .

:Late-Registered_Participant
        a                 owl:Class ;
        rdfs:subClassOf   :Conference_Participant ;
        owl:disjointWith  :Early-Registered_Participant .

:partOfEvent  a             owl:ObjectProperty , owl:TransitiveProperty ;
        rdfs:domain         :Event ;
        rdfs:range          :Event ;
        rdfs:subPropertyOf  :partOf ;
        owl:inverseOf       :hasEvent .

:hasEvent  a                owl:ObjectProperty ;
        rdfs:domain         :Event ;
        rdfs:range          :Event ;
        rdfs:subPropertyOf  :hasPart ;
        owl:inverseOf       :partOfEvent .

:University  a           owl:Class ;
        rdfs:subClassOf  :Academic_Institution .

:presentationOfPaper  a  owl:ObjectProperty ;
        rdfs:domain    :Individual_Presentation ;
        rdfs:range     _:b30 , _:b31 , _:b32 ;
        owl:inverseOf  :paperPresentedAs .

:Possible_Reviewer  a    owl:Class ;
        rdfs:subClassOf  :Person .

:Student  a              owl:Class ;
        rdfs:subClassOf  :Person .

:Invited_Speaker  a      owl:Class ;
        rdfs:subClassOf  :Presenter .

:Presenter  a            owl:Class ;
        rdfs:subClassOf  :Conference_Participant .

:SC_Member  a            owl:Class ;
        rdfs:subClassOf  :PC_Member .

:eventOnList  a        owl:ObjectProperty ;
        rdfs:domain    :Event ;
        rdfs:range     _:b33 , _:b34 , _:b35 ;
        owl:inverseOf  :listsEvent .

:listsEvent  a         owl:ObjectProperty ;
        rdfs:domain    _:b36 , _:b37 , _:b38 ;
        rdfs:range     :Event ;
        owl:inverseOf  :eventOnList .

:inverse_of_partOf_7  a     owl:ObjectProperty ;
        rdfs:range          :Event ;
        rdfs:subPropertyOf  :hasPart .

:hasPart  a            owl:ObjectProperty , owl:TransitiveProperty ;
        owl:inverseOf  :partOf .

:partOf  a             owl:ObjectProperty , owl:TransitiveProperty ;
        owl:inverseOf  :hasPart .

:references  a         owl:ObjectProperty ;
        owl:inverseOf  :referencedIn .

:referencedIn  a       owl:ObjectProperty ;
        owl:inverseOf  :references .

:reviewOfPaper  a      owl:ObjectProperty ;
        rdfs:domain    :Review ;
        rdfs:range     :Paper ;
        owl:inverseOf  :hasReview .

:organisedBy  a        owl:ObjectProperty ;
        rdfs:domain    :Event ;
        rdfs:range     _:b39 , _:b40 , _:b41 ;
        owl:inverseOf  :organises .

:organises  a          owl:ObjectProperty ;
        rdfs:domain    _:b42 , _:b43 , _:b44 ;
        rdfs:range     :Event ;
        owl:inverseOf  :organisedBy .

:paperPresentedAs  a   owl:ObjectProperty ;
        rdfs:domain    _:b45 , _:b46 , _:b47 ;
        rdfs:range     :Individual_Presentation ;
        owl:inverseOf  :presentationOfPaper .

:reviewerOfPaper  a    owl:ObjectProperty ;
        rdfs:domain    :Possible_Reviewer ;
        rdfs:range     :Paper ;
        owl:inverseOf  :hasReviewer .

:locationOf  a         owl:ObjectProperty ;
        rdfs:domain    :Location ;
        rdfs:range     :Event ;
        owl:inverseOf  :heldIn .

:heldIn  a             owl:ObjectProperty ;
        rdfs:domain    :Event ;
        rdfs:range     :Location ;
        owl:inverseOf  :locationOf .

:publisherOf  a      owl:ObjectProperty ;
        rdfs:domain  :Organisation ;
        rdfs:range   _:b48 , _:b49 , _:b50 .

:scientificallyOrganises
        a                   owl:ObjectProperty ;
        rdfs:domain         :Academic_Institution ;
        rdfs:subPropertyOf  :organises ;
        owl:inverseOf       :scientificallyOrganisedBy .

:scientificallyOrganisedBy
        a                   owl:ObjectProperty ;
        rdfs:range          :Academic_Institution ;
        rdfs:subPropertyOf  :organisedBy ;
        owl:inverseOf       :scientificallyOrganises .

:authorOf  a           owl:ObjectProperty ;
        rdfs:domain    :Person ;
        rdfs:range     :Document ;
        owl:inverseOf  :writtenBy .

:hasUpdatedVersion  a  owl:ObjectProperty ;
        rdfs:domain    :Document ;
        rdfs:range     :Document ;
        owl:inverseOf  :updatedVersionOf .

:technicallyOrganisedBy
        a                   owl:ObjectProperty ;
        rdfs:subPropertyOf  :organisedBy ;
        owl:inverseOf       :technicallyOrganises .

:technicallyOrganises
        a                   owl:ObjectProperty ;
        rdfs:domain         :Organisation ;
        rdfs:subPropertyOf  :organises ;
        owl:inverseOf       :technicallyOrganisedBy .

:paperInVolume  a      owl:ObjectProperty ;
        owl:inverseOf  :volumeContainsPaper .

:coversTopic  a        owl:ObjectProperty ;
        rdfs:domain    _:b51 , _:b52 , _:b53 ;
        rdfs:range     :Research_Topic ;
        owl:inverseOf  :topicCoveredBy .

:topicCoveredBy  a     owl:ObjectProperty ;
