@prefix :      <http://cmt#> .
@prefix xsp:   <http://www.owl-ontologies.com/2005/08/07/xsp.owl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix swrl:  <http://www.w3.org/2003/11/swrl#> .
@prefix protege: <http://protege.stanford.edu/plugins/owl/protege#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://cmt>  a  owl:Ontology .

xsd:date  a     rdfs:Datatype .

:acceptPaper  a        owl:ObjectProperty , owl:InverseFunctionalProperty ;
        rdfs:domain    :Administrator ;
        rdfs:range     :Paper ;
        owl:inverseOf  :acceptedBy .

:acceptedBy  a       owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain  :Paper ;
        rdfs:range   :Administrator .

:Administrator  a        owl:Class ;
        rdfs:subClassOf  :User .

:Paper  a                 owl:Class ;
        rdfs:subClassOf   :Document , _:b0 , _:b1 , _:b2 , _:b3 ;
        owl:disjointWith  :Review .

:addProgramCommitteeMember
        a              owl:ObjectProperty , owl:InverseFunctionalProperty ;
        rdfs:domain    :Administrator ;
        rdfs:range     :ProgramCommitteeMember ;
        owl:inverseOf  :addedBy .

:addedBy  a          owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain  :ProgramCommitteeMember ;
        rdfs:range   :Administrator .

:ProgramCommitteeMember
        a                owl:Class ;
        rdfs:comment     "The Program Committee consists of all members of the conference except for Authors who are not also Reviewers." ;
        rdfs:subClassOf  :ConferenceMember , :Person .

:adjustBid  a          owl:ObjectProperty , owl:InverseFunctionalProperty ;
        rdfs:domain    :Reviewer ;
        rdfs:range     :Bid ;
        owl:inverseOf  :adjustedBy .

:adjustedBy  a       owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain  :Bid ;
        rdfs:range   :Reviewer .

:Reviewer  a             owl:Class ;
        rdfs:subClassOf  :ConferenceMember , :User .

:Bid    a                 owl:Class ;
        owl:disjointWith  :Conference , :Person , :Document , :Decision , :ProgramCommittee , :Preference .

:assignExternalReviewer
        a              owl:ObjectProperty , owl:InverseFunctionalProperty ;
        rdfs:domain    :Reviewer ;
        rdfs:range     :ExternalReviewer ;
        owl:inverseOf  :assignedByReviewer .

:assignedByReviewer  a  owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain  :ExternalReviewer ;
        rdfs:range   :Reviewer .

:ExternalReviewer  a      owl:Class ;
        rdfs:comment      "An External Reviewer is a person that has been assigned to review a paper for another Reviewer, but is not themselves a Reviewer. " ;
        rdfs:subClassOf   :Person , _:b4 ;
        owl:disjointWith  :Reviewer .

:assignReviewer  a     owl:ObjectProperty ;
        rdfs:domain    :Administrator ;
        rdfs:range     :Reviewer ;
        owl:inverseOf  :assignedByAdministrator .

:assignedByAdministrator
        a            owl:ObjectProperty ;
        rdfs:domain  :Reviewer ;
        rdfs:range   :Administrator .

:assignedTo  a         owl:ObjectProperty ;
        rdfs:domain    :Paper ;
        rdfs:range     :Reviewer ;
        owl:inverseOf  :hasBeenAssigned .

:hasBeenAssigned  a  owl:ObjectProperty ;
        rdfs:domain  :Reviewer ;
        rdfs:range   :Paper .

:co-writePaper  a      owl:ObjectProperty ;
        rdfs:domain    :Co-author ;
        rdfs:range     :Paper ;
        owl:inverseOf  :hasCo-author .

:hasCo-author  a     owl:ObjectProperty ;
        rdfs:domain  :Paper ;
        rdfs:range   :Co-author .

:Co-author  a            owl:Class ;
        rdfs:subClassOf  :Author .

:detailsEnteredBy  a   owl:ObjectProperty ;
        rdfs:domain    :Conference ;
        rdfs:range     :Administrator ;
        owl:inverseOf  :enterConferenceDetails .

:enterConferenceDetails
        a            owl:ObjectProperty ;
        rdfs:domain  :Administrator ;
        rdfs:range   :Conference .

:Conference  a            owl:Class ;
        rdfs:subClassOf   owl:Thing , _:b5 , _:b6 , _:b7 ;
        owl:disjointWith  :Person , :Document , :Decision , :ProgramCommittee , :Preference .

:enableVirtualMeeting
        a              owl:ObjectProperty ;
        rdfs:domain    :Administrator ;
        rdfs:range     :Conference ;
        owl:inverseOf  :virtualMeetingEnabledBy .

:virtualMeetingEnabledBy
        a            owl:ObjectProperty ;
        rdfs:domain  :Conference ;
        rdfs:range   :Administrator .

:endReview  a        owl:ObjectProperty ;
        rdfs:domain  :ProgramCommitteeChair ;
        rdfs:range   :Review .

:ProgramCommitteeChair
        a                owl:Class ;
        rdfs:subClassOf  :ProgramCommitteeMember .

:Review  a               owl:Class ;
        rdfs:subClassOf  :Document .

:enterReviewCriteria  a  owl:ObjectProperty ;
        rdfs:domain    :Administrator ;
        rdfs:range     :Conference ;
        owl:inverseOf  :reviewCriteriaEnteredBy .

:reviewCriteriaEnteredBy
        a            owl:ObjectProperty ;
        rdfs:domain  :Conference ;
        rdfs:range   :Administrator .

:finalizePaperAssignment
        a              owl:ObjectProperty ;
        rdfs:domain    :Administrator ;
        rdfs:range     :Conference ;
        owl:inverseOf  :paperAssignmentFinalizedBy .

:paperAssignmentFinalizedBy
        a            owl:ObjectProperty ;
        rdfs:domain  :Conference ;
        rdfs:range   :Administrator .

:hardcopyMailingManifestsPrintedBy
        a              owl:ObjectProperty ;
        rdfs:domain    :Conference ;
        rdfs:range     :Administrator ;
        owl:inverseOf  :printHardcopyMailingManifests .

:printHardcopyMailingManifests
        a            owl:ObjectProperty ;
        rdfs:domain  :Administrator ;
        rdfs:range   :Conference .

:hasAuthor  a          owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain    :Paper ;
        rdfs:range     :Author ;
        owl:inverseOf  :writePaper .

:writePaper  a       owl:ObjectProperty , owl:InverseFunctionalProperty ;
        rdfs:domain  :Author ;
        rdfs:range   :Paper .

:Author  a               owl:Class ;
        rdfs:subClassOf  :ConferenceMember , :User .

:hasBid  a           owl:ObjectProperty , owl:InverseFunctionalProperty ;
        rdfs:domain  :Paper ;
        rdfs:range   :Bid .

:hasConferenceMember  a  owl:ObjectProperty ;
        rdfs:domain    :Conference ;
        rdfs:range     :ConferenceMember ;
        owl:inverseOf  :memberOfConference .

:memberOfConference  a  owl:ObjectProperty ;
        rdfs:domain  :ConferenceMember ;
        rdfs:range   :Conference .

:ConferenceMember  a     owl:Class ;
        rdfs:subClassOf  :Person .

:hasConflictOfInterest
        a            owl:ObjectProperty ;
        rdfs:domain  :Person ;
        rdfs:range   :Document .

:Person  a                owl:Class ;
        owl:disjointWith  :ProgramCommittee , :Preference .

:Document  a              owl:Class ;
        owl:disjointWith  :Person , :ProgramCommittee , :Preference .

:hasDecision  a      owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain  :Paper ;
        rdfs:range   :Decision .

:Decision  a              owl:Class ;
        owl:disjointWith  :Person , :Document , :ProgramCommittee , :Preference .

:hasProgramCommitteeMember
        a              owl:ObjectProperty ;
        rdfs:domain    :ProgramCommittee ;
        rdfs:range     :ProgramCommitteeMember ;
        owl:inverseOf  :memberOfProgramCommittee .

:memberOfProgramCommittee
        a            owl:ObjectProperty ;
        rdfs:domain  :ProgramCommitteeMember ;
        rdfs:range   :ProgramCommittee .

:ProgramCommittee  a  owl:Class .

:hasSubjectArea  a   owl:ObjectProperty ;
        rdfs:domain  :Paper ;
        rdfs:range   :SubjectArea .

:SubjectArea  a  owl:Class .

:markConflictOfInterest
        a             owl:ObjectProperty ;
        rdfs:comment  "In CMT terms, a ‘Conflict of Interest’ is an association between a specific Reviewer and a specific Paper that states there is a conflict of interest between that Reviewer and that paper. Conflicts can be marked by Authors (during paper submission) or by Reviewers (in Phase 2) or by Chairmen (in Phase 3).\n\nBased on that conflict, the reviewer will not be able to bid on the paper, be assigned to that paper (either automatically by the system or manually by a Chairman) or view review submissions for that paper.\n" ;
        rdfs:domain   _:b8 ;
        rdfs:range    :Paper .

:Chairman  a                 owl:Class ;
        rdfs:subClassOf      :Person ;
        owl:equivalentClass  [ a            owl:Class ;
                               owl:unionOf  ( :AssociatedChair :ConferenceChair :ProgramCommitteeChair )
                             ] .

:paperAssignmentToolsRunBy
        a              owl:ObjectProperty ;
        rdfs:domain    :Conference ;
        rdfs:range     :Administrator ;
        owl:inverseOf  :runPaperAssignmentTools .

:runPaperAssignmentTools
        a            owl:ObjectProperty ;
        rdfs:domain  :Administrator ;
        rdfs:range   :Conference .

:readByMeta-Reviewer  a  owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain  :Paper ;
        rdfs:range   :Meta-Reviewer .

:Meta-Reviewer  a        owl:Class ;
        rdfs:comment     "A special type of Reviewer.  There can be any number of Reviewers for a given paper, but only one Meta-Reviewer.  The Meta-Reviewer can go over all the reviews submitted for the paper and submit their own review.  Questions for the Meta-Reviewer can be different from those for a normal Reviewer.  Their role is to ensure that the reviews are good and consistent. The decision to use Meta-Reviewers is optional, and must be set before paper assignment occurs." ;
        rdfs:subClassOf  :Reviewer .

:readByReviewer  a     owl:ObjectProperty ;
        rdfs:domain    :Paper ;
        rdfs:range     :Reviewer ;
        owl:inverseOf  :readPaper .

:readPaper  a        owl:ObjectProperty ;
        rdfs:domain  :Reviewer ;
        rdfs:range   :Paper .

:rejectPaper  a        owl:ObjectProperty , owl:InverseFunctionalProperty ;
        rdfs:domain    :Administrator ;
        rdfs:range     :Paper ;
        owl:inverseOf  :rejectedBy .

:rejectedBy  a       owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain  :Paper ;
        rdfs:range   :Administrator .

:reviewerBiddingStartedBy
        a              owl:ObjectProperty ;
        rdfs:domain    :Conference ;
        rdfs:range     :Administrator ;
        owl:inverseOf  :startReviewerBidding .

:startReviewerBidding
        a            owl:ObjectProperty ;
        rdfs:domain  :Administrator ;
        rdfs:range   :Conference .

:setMaxPapers  a     owl:ObjectProperty ;
        rdfs:domain  :Administrator ;
        rdfs:range   :ProgramCommitteeMember .

:submitPaper  a      owl:ObjectProperty ;
        rdfs:domain  :Author ;
        rdfs:range   :Paper .

:writeReview  a        owl:ObjectProperty , owl:InverseFunctionalProperty ;
        rdfs:domain    :Reviewer ;
        rdfs:range     :Review ;
        owl:inverseOf  :writtenBy .

:writtenBy  a        owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain  :Review ;
        rdfs:range   :Reviewer .

:acceptsHardcopySubmissions
        a            owl:FunctionalProperty , owl:DatatypeProperty ;
        rdfs:domain  :Conference ;
        rdfs:range   xsd:boolean .

:date   a            owl:DatatypeProperty ;
        rdfs:domain  :Conference ;
        rdfs:range   xsd:date .

:email  a            owl:DatatypeProperty ;
        rdfs:domain  :Person ;
        rdfs:range   xsd:string .

:logoURL  a          owl:FunctionalProperty , owl:DatatypeProperty ;
        rdfs:domain  :Conference ;
        rdfs:range   xsd:anyURI .

:maxPapers  a        owl:FunctionalProperty , owl:DatatypeProperty ;
        rdfs:domain  :ProgramCommitteeMember ;
        rdfs:range   xsd:int .

:name   a            owl:FunctionalProperty , owl:DatatypeProperty ;
        rdfs:domain  _:b9 ;
        rdfs:range   xsd:string .

:paperID  a          owl:FunctionalProperty , owl:DatatypeProperty ;
        rdfs:domain  :Paper ;
        rdfs:range   xsd:unsignedLong .

:reviewsPerPaper  a  owl:FunctionalProperty , owl:DatatypeProperty ;
        rdfs:domain  :Conference ;
        rdfs:range   xsd:int .

:siteURL  a          owl:FunctionalProperty , owl:DatatypeProperty ;
        rdfs:domain  :Conference ;
        rdfs:range   xsd:anyURI .

:title  a            owl:FunctionalProperty , owl:DatatypeProperty ;
        rdfs:domain  :Paper ;
        rdfs:range   xsd:string .

:Acceptance  a            owl:Class ;
        rdfs:subClassOf   :Decision ;
        owl:disjointWith  :Rejection .

:Rejection  a            owl:Class ;
        rdfs:subClassOf  :Decision .

:User   a                owl:Class ;
        rdfs:subClassOf  :Person .

:AssociatedChair  a       owl:Class ;
        rdfs:subClassOf   :ConferenceMember ;
        owl:disjointWith  :ConferenceChair .

:ConferenceChair  a      owl:Class ;
        rdfs:subClassOf  :ConferenceMember .

:AuthorNotReviewer  a     owl:Class ;
        rdfs:subClassOf   :Author ;
        owl:disjointWith  :ProgramCommitteeMember , :Reviewer .

:Preference  a            owl:Class ;
        owl:disjointWith  :ProgramCommittee .

:Meta-Review  a          owl:Class ;
        rdfs:subClassOf  :Review .

:PaperAbstract  a        owl:Class ;
        rdfs:subClassOf  :Paper .

:PaperFullVersion  a     owl:Class ;
        rdfs:subClassOf  :Paper .

